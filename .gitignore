# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environment
env/
venv/
.venv/
# PyInstaller generated build artifacts
build/
dist/
resources/
# Logs and debug information
*.spec
*.log

# Temporary files created during PyInstaller runs
*.tmp
*.temp
*.bak
# UI files converted to Python
*.ui

# PyQt Designer autosave files
*.autosave

# Resource files generated by rcc (resource compiler)
*_rc.py

# PyQt debugging files
*.pydevd.*
# OS-specific files
.DS_Store
Thumbs.db

# IDE-specific files
.idea/
.vscode/
*.iml

*.swp
*.swo
*.exe
*.dmg
*.app
*.so
*.dll
*.pkg
*.deb
*.rpm
